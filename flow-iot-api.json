  {
    "id": "v4_page_tpl",
    "type": "template",
    "z": "v4_tab",
    "name": "Dashboard HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>IoT Dashboard - REST API</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }\n    body { background: linear-gradient(135deg, #667eea, #764ba2); min-height: 100vh; padding: 20px; color: #333; }\n    .container { max-width: 1000px; margin: 0 auto; }\n    h1 { color: white; text-align: center; margin-bottom: 25px; font-size: 28px; }\n    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }\n    .card { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); text-align: center; transition: transform 0.2s; }\n    .card:hover { transform: translateY(-5px); }\n    .card .label { font-size: 14px; color: #888; text-transform: uppercase; letter-spacing: 1px; }\n    .card .value { font-size: 42px; font-weight: bold; margin: 10px 0; color: #667eea; }\n    .card .value.alert { color: #dc3545; }\n    .card .unit { font-size: 18px; color: #aaa; }\n    .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; }\n    .status-online { background: #d4edda; color: #155724; }\n    .status-offline { background: #f8d7da; color: #721c24; }\n    #alert-banner { display: none; background: #dc3545; color: white; padding: 14px 20px; border-radius: 12px; margin-bottom: 25px; font-weight: 600; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }\n    .panel { background: white; border-radius: 15px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); margin-bottom: 25px; }\n    .panel h2 { font-size: 18px; margin-bottom: 15px; color: #444; }\n    .controls { display: flex; gap: 15px; flex-wrap: wrap; align-items: center; }\n    .btn { padding: 12px 30px; border: none; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s; }\n    .btn-on { background: #28a745; color: white; }\n    .btn-on:hover { background: #218838; }\n    .btn-off { background: #dc3545; color: white; }\n    .btn-off:hover { background: #c82333; }\n    .btn-save { background: #667eea; color: white; }\n    .btn-save:hover { background: #5568d3; }\n    input[type=number] { padding: 11px; border: 1px solid #ccc; border-radius: 10px; font-size: 15px; width: 120px; }\n    table { width: 100%; border-collapse: collapse; }\n    th, td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }\n    th { background: #f8f9fa; color: #666; text-transform: uppercase; font-size: 12px; }\n    tr:hover td { background: #f9f9f9; }\n    #log { background: #1e1e1e; color: #0f0; font-family: monospace; padding: 15px; border-radius: 10px; max-height: 180px; overflow-y: auto; font-size: 13px; line-height: 1.6; }\n    #log .error { color: #f66; }\n    #log .info { color: #6af; }\n  </style>\n</head>\n<body>\n<div class=\"container\">\n  <h1>IoT Dashboard — REST API</h1>\n\n  <div id=\"alert-banner\"></div>\n\n  <div class=\"cards\">\n    <div class=\"card\">\n      <div class=\"label\">Suhu</div>\n      <div class=\"value\" id=\"suhu\">--</div>\n      <div class=\"unit\">°C</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"label\">Kelembaban</div>\n      <div class=\"value\" id=\"kelembaban\">--</div>\n      <div class=\"unit\">%</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"label\">Status Sensor</div>\n      <div class=\"value\" style=\"font-size:22px;\">\n        <span class=\"status-badge status-offline\" id=\"status-badge\">OFFLINE</span>\n      </div>\n      <div id=\"mode\" style=\"font-size:12px;color:#888;margin-top:8px;\">Mode: -</div>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Grafik Real-time (20 data terakhir)</h2>\n    <canvas id=\"grafik\" height=\"110\"></canvas>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Kontrol Perangkat</h2>\n    <div class=\"controls\">\n      <button class=\"btn btn-on\" onclick=\"kontrol('lamp','on')\">Nyalakan Lampu</button>\n      <button class=\"btn btn-off\" onclick=\"kontrol('lamp','off')\">Matikan Lampu</button>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Batas Suhu (Threshold)</h2>\n    <div class=\"controls\">\n      <span>Batas maksimum (°C):</span>\n      <input type=\"number\" id=\"threshold-input\" step=\"0.5\" value=\"30\">\n      <button class=\"btn btn-save\" onclick=\"simpanThreshold()\">Simpan Batas</button>\n    </div>\n  </div>\n\n  <div class=\"panel\">\n    <h2>10 Data Sensor Terakhir</h2>\n    <table>\n      <thead>\n        <tr><th>Waktu</th><th>Suhu (°C)</th><th>Kelembaban (%)</th></tr>\n      </thead>\n      <tbody id=\"history-body\">\n        <tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Loading...</td></tr>\n      </tbody>\n    </table>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Log Aktivitas</h2>\n    <div id=\"log\"></div>\n  </div>\n</div>\n\n<script>\n// Kalau dibuka dari Node-RED (http://localhost:1880/iot) pakai alamat relatif,\n// kalau dibuka langsung sebagai file pakai alamat penuh.\nconst API_BASE = location.protocol === 'file:' ? 'http://localhost:1880/api' : '/api';\nconst WS_URL = location.protocol === 'file:'\n  ? 'ws://localhost:1880/ws/sensor'\n  : (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws/sensor';\nconst API_KEY = 'iot-key-2026';\n\nlet hist = [];            // riwayat data sensor di sisi browser\nlet lastReceived = 0;\nlet thresholdInit = false;\nlet wasAlert = false;\nlet pollTimers = [];\nlet ws = null;\nlet wsDownLogged = false;\nlet sourceLogged = false;\n\nfunction log(msg, type = 'info') {\n  const el = document.getElementById('log');\n  const time = new Date().toLocaleTimeString();\n  el.innerHTML += `<div class=\"${type}\">[${time}] ${msg}</div>`;\n  el.scrollTop = el.scrollHeight;\n}\n\nfunction setBadge(online) {\n  const badge = document.getElementById('status-badge');\n  badge.textContent = online ? 'ONLINE' : 'OFFLINE';\n  badge.className = 'status-badge ' + (online ? 'status-online' : 'status-offline');\n}\n\nfunction setMode(text) {\n  document.getElementById('mode').textContent = 'Mode: ' + text;\n}\n\n// status ONLINE/OFFLINE dihitung dari umur data terakhir (timer lokal, bukan request ke server)\nfunction updateBadge() {\n  setBadge(lastReceived > 0 && (Date.now() - lastReceived) < 10000);\n}\nsetInterval(updateBadge, 2000);\n\nconst chart = (typeof Chart !== 'undefined') ? new Chart(document.getElementById('grafik'), {\n  type: 'line',\n  data: {\n    labels: [],\n    datasets: [\n      { label: 'Suhu (°C)', data: [], borderColor: '#e8590c', backgroundColor: '#e8590c', tension: 0.3 },\n      { label: 'Kelembaban (%)', data: [], borderColor: '#1c7ed6', backgroundColor: '#1c7ed6', tension: 0.3 }\n    ]\n  },\n  options: { responsive: true, animation: false }\n}) : null;\n\nfunction renderSensor(data, threshold, alert) {\n  if (!data || data.suhu === null || data.suhu === undefined) return;\n  const suhuEl = document.getElementById('suhu');\n  const banner = document.getElementById('alert-banner');\n  suhuEl.textContent = data.suhu;\n  document.getElementById('kelembaban').textContent = data.kelembaban;\n  lastReceived = new Date(data.received).getTime();\n  updateBadge();\n\n  if (!thresholdInit && threshold !== undefined) {\n    document.getElementById('threshold-input').value = threshold;\n    thresholdInit = true;\n  }\n  if (alert) {\n    suhuEl.classList.add('alert');\n    banner.style.display = 'block';\n    banner.textContent = `PERINGATAN: suhu ${data.suhu} °C melewati batas ${threshold} °C`;\n    if (!wasAlert) log(`Peringatan: suhu ${data.suhu} melewati batas ${threshold}`, 'error');\n  } else {\n    suhuEl.classList.remove('alert');\n    banner.style.display = 'none';\n  }\n  wasAlert = alert;\n}\n\nfunction renderHistory() {\n  const tbody = document.getElementById('history-body');\n  if (hist.length === 0) {\n    tbody.innerHTML = '<tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Belum ada data</td></tr>';\n    return;\n  }\n  tbody.innerHTML = hist.slice(-10).reverse().map(d => `\n    <tr>\n      <td>${new Date(d.received).toLocaleTimeString()}</td>\n      <td>${d.suhu}</td>\n      <td>${d.kelembaban}</td>\n    </tr>\n  `).join('');\n\n  if (chart) {\n    const last = hist.slice(-20);\n    chart.data.labels = last.map(d => new Date(d.received).toLocaleTimeString());\n    chart.data.datasets[0].data = last.map(d => d.suhu);\n    chart.data.datasets[1].data = last.map(d => d.kelembaban);\n    chart.update();\n  }\n}\n\n// ---------- REST (dipakai sekali di awal, dan sebagai cadangan kalau WebSocket putus) ----------\nasync function fetchSensor() {\n  try {\n    const res = await fetch(`${API_BASE}/suhu`);\n    const json = await res.json();\n    if (json.status === 'success') renderSensor(json.data, json.threshold, json.alert);\n  } catch (err) {\n    log(`Gagal fetch sensor: ${err.message}`, 'error');\n  }\n}\n\nasync function fetchHistory() {\n  try {\n    const res = await fetch(`${API_BASE}/history`);\n    const json = await res.json();\n    hist = json.data || [];\n    renderHistory();\n    if (!sourceLogged && json.source) {\n      log(`History dimuat dari ${json.source} (${json.count} data)`, 'info');\n      sourceLogged = true;\n    }\n  } catch (err) {\n    log(`Gagal fetch history: ${err.message}`, 'error');\n  }\n}\n\nfunction startPolling() {\n  if (pollTimers.length) return;\n  fetchSensor();\n  fetchHistory();\n  pollTimers = [setInterval(fetchSensor, 3000), setInterval(fetchHistory, 5000)];\n}\n\nfunction stopPolling() {\n  pollTimers.forEach(clearInterval);\n  pollTimers = [];\n}\n\n// ---------- WebSocket ----------\nfunction connectWS() {\n  ws = new WebSocket(WS_URL);\n\n  ws.onopen = () => {\n    wsDownLogged = false;\n    stopPolling();\n    setMode('WebSocket (tanpa polling)');\n    log('WebSocket terhubung, data di-push dari server', 'info');\n    fetchHistory();   // sekali saja, untuk mengisi riwayat awal\n    fetchSensor();\n  };\n\n  ws.onmessage = (ev) => {\n    let m;\n    try { m = JSON.parse(ev.data); } catch (e) { return; }\n    if (m.type === 'sensor') {\n      hist.push(m.data);\n      if (hist.length > 50) hist.shift();\n      renderSensor(m.data, m.threshold, m.alert);\n      renderHistory();\n    }\n  };\n\n  ws.onclose = () => {\n    setMode('Polling (WebSocket terputus)');\n    if (!wsDownLogged) {\n      log('WebSocket terputus, kembali ke polling', 'error');\n      wsDownLogged = true;\n    }\n    startPolling();\n    setTimeout(connectWS, 3000);\n  };\n\n  ws.onerror = () => { ws.close(); };\n}\n\n// ---------- Kontrol & threshold ----------\nasync function kontrol(device, action) {\n  try {\n    const res = await fetch(`${API_BASE}/kontrol`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'X-API-Key': API_KEY },\n      body: JSON.stringify({ device, action })\n    });\n    const json = await res.json();\n    if (json.status === 'success') {\n      log(`Perintah terkirim: ${device} → ${action}`, 'info');\n    } else {\n      log(`Gagal: ${json.message}`, 'error');\n    }\n  } catch (err) {\n    log(`Error kontrol: ${err.message}`, 'error');\n  }\n}\n\nasync function simpanThreshold() {\n  const max = parseFloat(document.getElementById('threshold-input').value);\n  try {\n    const res = await fetch(`${API_BASE}/threshold`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json', 'X-API-Key': API_KEY },\n      body: JSON.stringify({ max })\n    });\n    const json = await res.json();\n    if (json.status === 'success') {\n      log(`Batas suhu diubah menjadi ${json.max} °C`, 'info');\n    } else {\n      log(`Gagal: ${json.message}`, 'error');\n    }\n  } catch (err) {\n    log(`Error threshold: ${err.message}`, 'error');\n  }\n}\n\nlog('Dashboard dimulai, menghubungkan WebSocket...');\nconnectWS();\n</script>\n</body>\n</html>\n",
