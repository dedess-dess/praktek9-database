  {
    "id": "v4_store",
    "type": "function",
    "z": "v4_tab",
    "name": "Simpan Data & Cek Batas",
    "outputs": 3,
    "x": 400,
    "y": 80,
    "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\n// simpan ke database SQLite (kalau tersedia), history tetap ada walau Node-RED dimatikan\nvar db = global.get('iotdb');\nif (db) {\n  try {\n    db.exec(\"CREATE TABLE IF NOT EXISTS sensor_log (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, timestamp TEXT, received TEXT)\");\n    db.prepare('INSERT INTO sensor_log (suhu, kelembaban, timestamp, received) VALUES (?, ?, ?, ?)')\n      .run(Number(data.suhu), Number(data.kelembaban), String(data.timestamp || ''), data.received);\n  } catch (e) {\n    node.error('DB insert gagal: ' + e.message);\n  }\n}\n\nvar max = flow.get('thresholdMax');\nif (max === undefined) { max = 30; flow.set('thresholdMax', max); }\nvar over = data.suhu > max;\nvar was = flow.get('alerting') || false;\nflow.set('alerting', over);\n\nvar notif = null;\nif (over && !was) {\n  notif = {topic: 'iot/notifikasi', payload: {\n    tipe: 'peringatan',\n    pesan: 'Suhu ' + data.suhu + ' C melewati batas ' + max + ' C',\n    suhu: data.suhu, batas: max, waktu: data.received\n  }};\n  node.warn(notif.payload.pesan);\n}\n\n// push ke semua dashboard yang terhubung lewat WebSocket\nvar wsMsg = {payload: {type: 'sensor', data: data, threshold: max, alert: over}};\nreturn [msg, notif, wsMsg];",
    "wires": [
      [
        "v4_debug"
      ],
      [
        "v4_notif_out"
      ],
      [
        "v4_ws_out"
      ]
    ]
  },
