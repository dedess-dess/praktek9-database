  {
    "id": "v4_fn_suhu",
    "type": "function",
    "z": "v4_tab",
    "name": "Build Response Suhu",
    "outputs": 1,
    "x": 410,
    "y": 180,
    "func": "var data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nvar max = flow.get('thresholdMax');\nif (max === undefined) max = 30;\nmsg.payload = {\n  status: 'success',\n  data: data,\n  threshold: max,\n  alert: !!flow.get('alerting'),\n  server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "wires": [
      [
        "v4_resp_suhu"
      ]
    ]
  },
