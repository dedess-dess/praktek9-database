  {
    "id": "v4_fn_kontrol",
    "type": "function",
    "z": "v4_tab",
    "name": "Cek Key, Validasi & Publish",
    "outputs": 2,
    "x": 420,
    "y": 330,
    "func": "var KEY = 'iot-key-2026';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (!msg.req || msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'API key salah atau tidak ada'};\n  return [msg, null];\n}\n\nvar body = msg.payload;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = null; } }\nif (!body || !body.device || !body.action) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n  return [msg, null];\n}\n\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: body};\nreturn [msg, mqttMsg];",
    "wires": [
      [
        "v4_resp_kontrol"
      ],
