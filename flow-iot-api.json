  {
    "id": "v4_fn_put_thr",
    "type": "function",
    "z": "v4_tab",
    "name": "Cek Key & Set Threshold",
    "outputs": 1,
    "x": 430,
    "y": 500,
    "func": "var KEY = 'iot-key-2026';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (!msg.req || msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'API key salah atau tidak ada'};\n  return msg;\n}\n\nvar max = Number(msg.payload && msg.payload.max);\nif (isNaN(max) || max < 0 || max > 100) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'max harus angka 0 sampai 100'};\n  return msg;\n}\nflow.set('thresholdMax', max);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diubah', max: max};\nreturn msg;",
