  {
    "id": "v4_fn_hist",
    "type": "function",
    "z": "v4_tab",
    "name": "Build Response History",
    "outputs": 1,
    "x": 410,
    "y": 250,
    "func": "var db = global.get('iotdb');\nvar rows = null;\nvar source = 'memory';\nif (db) {\n  try {\n    db.exec(\"CREATE TABLE IF NOT EXISTS sensor_log (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, timestamp TEXT, received TEXT)\");\n    rows = db.prepare('SELECT suhu, kelembaban, timestamp, received FROM sensor_log ORDER BY id DESC LIMIT 50')\n      .all().reverse().map(function (r) {\n        return {suhu: r.suhu, kelembaban: r.kelembaban, timestamp: r.timestamp, received: r.received};\n      });\n    source = 'sqlite';\n  } catch (e) {\n    node.warn('DB history gagal: ' + e.message);\n    rows = null;\n  }\n}\nif (!rows) { rows = flow.get('history') || []; source = 'memory'; }\n\nmsg.payload = {\n  status: 'success',\n  source: source,\n  count: rows.length,\n  data: rows\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "wires": [
      [
        "v4_resp_hist"
      ]
    ]
  },
