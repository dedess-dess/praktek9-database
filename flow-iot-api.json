  {
    "id": "v4_sensor_in",
    "type": "mqtt in",
    "z": "v4_tab",
    "name": "Subscribe Sensor",
    "topic": "iot/sensor",
    "qos": "0",
    "datatype": "json",
    "broker": "v4_broker",
